FROM rust:alpine AS base

RUN apk add --no-cache build-base openssl-dev pkgconfig
ENV RUSTFLAGS="-C target-feature=-crt-static"

# sqlx-cli@0.9.0 allows for "-- no transaction" flag to be passed which is necessary for
# TimescaleDB continuous/realtime aggregates
RUN cargo install --locked sqlx-cli@0.9.0 --no-default-features --features native-tls,postgres

FROM base AS final
COPY /migrations /migrations
CMD ["sqlx", "migrate", "run"]
