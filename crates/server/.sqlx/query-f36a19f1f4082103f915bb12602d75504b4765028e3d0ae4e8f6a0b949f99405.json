  "query": "\n            SELECT\n                trade_time,\n                symbol,\n                trade_id,\n                side AS \"side: _\",\n                price,\n                quantity,\n                exchange,\n                event_time\n            FROM market_data.trades\n            WHERE symbol = $1\n            ORDER BY trade_time ASC\n            ",
