ARG RUST_VERSION=1.99
ARG APP_NAME=dashboard

FROM rust:${RUST_VERSION}-alpine AS base
RUN apk add --no-cache \
    pkgconfig \
    musl-dev \
    perl \
    make
RUN cargo install --locked trunk
RUN rustup target add wasm32-unknown-unknown
WORKDIR /app

FROM base AS final
# required as trunk has no way to dynamically pass environment variables at runtime
ARG APP_GRAPHQL_ENDPOINT=http://server:8080/api/graphql
RUN rustup target add wasm32-unknown-unknown
COPY . .
WORKDIR /app/crates/dashboard
ENTRYPOINT ["trunk", "serve"]